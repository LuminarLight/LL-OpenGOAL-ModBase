;;-*-Lisp-*-
(in-package goal)
;; Custom music player, based on the custom music system from The Forgotten Lands mod
;; (see README for credits).
(define *custom-music-playing?* #f)

(define *custom-music-stop* #f)

(deftype custom-music-player (process)
  ((stored-music symbol))
  (:methods
   (play! (_type_) none)
   (stop! (_type_) none)
   (set-stored-music! (_type_) none))
  (:states
   custom-music-player-idle
   custom-music-player-playing
   custom-music-player-fade))

(define *custom-music-player* (the (pointer custom-music-player) #f))

(defun custom-music-player-volume ()
  (-> *setting-control* current music-volume))

(defmethod set-stored-music! ((this custom-music-player))
  (set! (-> this stored-music) (-> *setting-control* default custom-music))
  (none))

(defun is-there-music? ((this custom-music-player))
  (when (and (!= (-> this stored-music) 0) (!= (-> this stored-music) #f))
    (return #t))
  #f)

(defmethod play! ((this custom-music-player))
  (when (is-there-music? this)
    (if *custom-music-playing?* (stop! this))
    (play-custom-music (symbol->string (-> this stored-music)) (custom-music-player-volume)))
  (none))

(defmethod stop! ((this custom-music-player))
  (when *custom-music-playing?*
    (true! *custom-music-stop*))
  (none))

(defmethod deactivate ((this custom-music-player))
  (stop! this)
  (false! *custom-music-playing?*)
  (false! *custom-music-stop*)
  (set! *custom-music-player* (the (pointer custom-music-player) #f))
  (call-parent-method this))

(defbehavior sleep-code process ()
  (logior! (-> self mask) (process-mask sleep-code))
  (loop
    (suspend))
  (none))

(defbehavior custom-music-player-init-by-other custom-music-player ()
  (set! *custom-music-player* (the (pointer custom-music-player) (process->ppointer self)))
  (set-stored-music! self)
  (go custom-music-player-idle)
  (none))

(defbehavior custom-music-player-post custom-music-player ()
  (let ((actual (-> *setting-control* default custom-music)))
    (when (!= (-> self stored-music) actual)
      (set-stored-music! self)
      (stop! self)))
  (none))

(defstatehandler custom-music-player :post custom-music-player-post)

(defstate custom-music-player-idle (custom-music-player)
  :code sleep-code
  :trans
    (behavior ()
      (when (is-there-music? self)
        (go custom-music-player-playing))))

(defstate custom-music-player-playing (custom-music-player)
  :enter
    (behavior ()
      (play! self)
      (dotimes (i 10)
        (suspend)))
  :code
    (behavior ()
      (while *custom-music-playing?*
        (suspend))
      (go custom-music-player-fade)))

(defstate custom-music-player-fade (custom-music-player)
  :code
    (behavior ()
      (when *custom-music-playing?*
        (stop! self))
      (dotimes (i 10)
        (suspend))
      (go custom-music-player-idle)))
